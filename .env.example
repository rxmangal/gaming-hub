# ---------------------------------------------------------------------------
# Unicity Arcade — environment
#
# Copy this file to `.env.local` for local development.
# On Vercel, add the same keys under Project Settings -> Environment Variables.
#
# NOTE: NEXT_PUBLIC_* values are embedded in the browser bundle. Never put a
# secret here. Nothing in this file is a secret.
# ---------------------------------------------------------------------------

# Hosted Sphere wallet used for the popup connect flow.
# The SDK opens `${NEXT_PUBLIC_SPHERE_WALLET_URL}/connect?origin=<your origin>`.
NEXT_PUBLIC_SPHERE_WALLET_URL=https://sphere.unicity.network


# ---------------------------------------------------------------------------
# ONLINE MULTIPLAYER (optional)
#
# Both games work fully WITHOUT these keys — "Single player" and "Local" modes
# need no server at all. Only "Online" (play a stranger/friend over the net)
# requires Supabase Realtime.
#
# Get these from https://supabase.com -> your project -> Settings -> API.
# The anon key is designed to be public; it is safe in the browser bundle.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
